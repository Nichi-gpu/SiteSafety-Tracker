# ===============================================
# SiteSafety Tracker - SMTP Configuration
# ===============================================

# 1. Your Gmail address
SMTP_EMAIL=your_email@gmail.com

# 2. Your 16-character Google App Password (NOT your normal login password!)
# Generate from: https://myaccount.google.com/apppasswords
SMTP_PASSWORD=xxxx xxxx xxxx xxxx

# 3. SMTP Server & Port (Defaults are already configured for Gmail)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
